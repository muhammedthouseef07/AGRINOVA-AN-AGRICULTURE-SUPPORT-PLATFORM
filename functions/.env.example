# Twilio Configuration Example for Firebase Cloud Functions
# Copy this file to .env inside the functions/ directory for local testing
# DO NOT commit .env with real credentials to GitHub.
# For production deployment, set secrets using:
#   firebase functions:secrets:set TWILIO_ACCOUNT_SID
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN
#   firebase functions:secrets:set TWILIO_PHONE_NUMBER

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
